---
// Short-link resolver. nginx rewrites /e/<code> and /t/<code> to this page
// (see nginx-static.conf); the client reads the code from the path, asks the
// backend which event/tournament it maps to, and redirects to the full detail
// page. Kept deliberately tiny — no nav chrome, so the hop is near-instant.
import { API_BASE } from '../../lib/config';
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex" />
  <title>Opening… | FYC</title>
  <style>
    body { font-family: system-ui, -apple-system, Segoe UI, Roboto, sans-serif;
           display: flex; min-height: 100vh; align-items: center; justify-content: center;
           margin: 0; background: #f0fdf4; color: #065f46; text-align: center; }
    .spin { width: 38px; height: 38px; border: 4px solid #a7f3d0; border-top-color: #059669;
            border-radius: 50%; animation: r .8s linear infinite; margin: 0 auto 14px; }
    @keyframes r { to { transform: rotate(360deg); } }
    a { color: #059669; }
  </style>
</head>
<body>
  <div>
    <div id="spin" class="spin"></div>
    <p id="msg">Opening…</p>
    <p id="fallback" style="display:none">
      This link doesn't exist or has expired.<br /><a href="/">Go to FYC home →</a>
    </p>
  </div>

  <script define:vars={{ API_BASE }}>
    (async () => {
      const m = window.location.pathname.match(/^\/(e|t)\/([0-9A-Za-z]{3,12})\/?$/);
      const fail = () => {
        document.getElementById('spin').style.display = 'none';
        document.getElementById('msg').style.display = 'none';
        document.getElementById('fallback').style.display = 'block';
      };
      if (!m) return fail();
      const [, kind, code] = m;
      const url = kind === 'e'
        ? `${API_BASE}/api/v1/events/by-code/${code}`
        : `${API_BASE}/api/v1/sports/tournaments/by-code/${code}`;
      try {
        const res = await fetch(url);
        if (!res.ok) return fail();
        const { id } = await res.json();
        const dest = kind === 'e'
          ? `/event-detail?id=${encodeURIComponent(id)}`
          : `/tournament-detail?id=${encodeURIComponent(id)}`;
        window.location.replace(dest);
      } catch (_e) {
        fail();
      }
    })();
  </script>
</body>
</html>
